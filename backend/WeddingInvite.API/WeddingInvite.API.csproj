<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableOpenApiSourceGenerator>true</DisableOpenApiSourceGenerator>
    <!-- SDK 10.0.300 bug: glob expansion fails in Docker on Linux (Web SDK adds Razor globs too) -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sentry.AspNetCore" Version="6.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeddingInvite.Core\WeddingInvite.Core.csproj" />
    <ProjectReference Include="..\WeddingInvite.Data\WeddingInvite.Data.csproj" />
    <ProjectReference Include="..\WeddingInvite.Models\WeddingInvite.Models.csproj" />
  </ItemGroup>

  <!--
    .NET SDK 10.0.102's static-web-assets project-system glob can admit generated JSON from
    bin/ and obj/ on macOS even though DefaultItemExcludes lists those directories. Once one
    output is admitted it is copied beneath the next output, producing bin/Debug/net10.0/bin/...
    recursively until MSBuild hits the platform path-length limit. Keep generated output out of
    every default item population explicitly so a stale bin folder cannot poison later builds.
  -->
  <ItemGroup>
    <Content Remove="bin/**;obj/**" />
    <None Remove="bin/**;obj/**" />
    <EmbeddedResource Remove="bin/**;obj/**" />
  </ItemGroup>

</Project>
