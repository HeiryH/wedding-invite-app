############################
# Node / Next.js
############################
node_modules/
.next/
out/

# Env files
.env
.env.local
.env.development
.env.production

############################
# .NET build output
############################
**/bin/
**/obj/
# Windows-style backslash directory names occasionally generated by dotnet on macOS.
# The doubled slash is a literal backslash in a gitignore pattern; the previous dangling
# backslash made the whole ignore file invalid to tools that parse Git globs.
backend/**/bin\\*/

############################
# Databases
############################
*.db
*.db-shm
*.db-wal
# Manual pre-migration backups — CLAUDE.md prescribes `cp wedding.db wedding.db.bak-$(date +%Y%m%d%H%M%S)`,
# and that name does not end in .db, so it escapes the rule above.
*.db.bak-*

############################
# Uploaded content
############################
**/wwwroot/uploads/

############################
# Deploy secrets
############################
.env.deploy

############################
# macOS
############################
.DS_Store

############################
# Hermes pipeline planning docs (invite-authoring board's own scratch
# notes — not application code, see docs/invite-pipeline.md instead)
############################
.hermes/
############################
# Local tooling / scratch (never application code)
############################
.worktrees/
.einvite-run/
.template-captures/
.codex/
.claude/
__pycache__/
*.tsbuildinfo
